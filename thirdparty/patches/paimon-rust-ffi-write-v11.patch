+fn write_rows<T>(
+    out: &mut Vec<u8>,
+    values: &[T],
+    encode: impl Fn(&T) -> crate::Result<Vec<u8>>,
+) -> crate::Result<()> {
+    out.extend_from_slice(&(values.len() as i32).to_be_bytes());
+    for value in values {
+        let row = encode(value)?;
+        out.extend_from_slice(&(row.len() as i32).to_be_bytes());
+        out.extend_from_slice(&row);
+    }
