+// ============ Native (external committer) write helpers ============
+//
+// These three entry points let a native engine drive the write path without a
+// JVM: export the writer's target Arrow schema, serialize a prepared commit
+// message range for an external committer, and report which Java
+// `CommitMessageSerializer` body version that serialization targets.
+//
+// The C ABI here is deliberately kept independent of the Paimon Java release
+// the crate happens to link: `paimon_commit_message_serializer_version()`
+// returns the version the *library* emits, so a native caller reads it at
+// startup and frames its payloads with it instead of hard-coding a number.
+// Moving to a newer Paimon (e.g. 2.1 / serializer v14) then only changes the
+// Rust side.
+
+/// Java `CommitMessageSerializer` body version emitted by
+/// `paimon_commit_messages_serialize_range`.
+///
+/// A native committer must frame each serialized range with this version; it is
+/// the version its own Java SDK has to be able to decode.
+#[no_mangle]
+pub extern "C" fn paimon_commit_message_serializer_version() -> i32 {
+    paimon::table::COMMIT_MESSAGE_SERIALIZER_VERSION
+}
+
+/// Export the table's write target Arrow schema.
+///
+/// This is the exact schema `paimon_table_write_write_arrow_batch` validates
+/// against (same `build_target_arrow_schema` call the writer uses), so a caller
+/// that builds its batches from this schema can never drift from what the
+/// writer expects. Fields appear in table order.
+///
+/// `out_schema` must point to writable storage for one `ArrowSchema` C struct
+/// (zero-initialized). On success the struct is initialized and owned by the
+/// caller: import it (Arrow C++ `ImportSchema` consumes the release callback)
+/// or release it through the struct's own `release` callback. On failure the
+/// storage is left untouched.
+///
+/// # Safety
+/// `table` must be a valid table handle, or null (returns an error).
+/// `out_schema` must point to writable storage for one `ArrowSchema`, or null.
+#[no_mangle]
+pub unsafe extern "C" fn paimon_table_export_arrow_schema(
+    table: *const paimon_table,
+    out_schema: *mut c_void,
+) -> *mut paimon_error {
+    if let Err(error) = check_non_null(table, "table") {
+        return error;
+    }
+    if out_schema.is_null() {
+        return invalid_input("out_schema must not be null");
+    }
+    let table_ref = &*((*table).inner as *const Table);
+    let schema = match paimon::arrow::build_target_arrow_schema(table_ref.schema().fields()) {
+        Ok(schema) => schema,
+        Err(error) => return paimon_error::from_paimon(error),
+    };
+    match FFI_ArrowSchema::try_from(schema.as_ref()) {
+        Ok(ffi_schema) => {
+            ptr::write(out_schema as *mut FFI_ArrowSchema, ffi_schema);
+            ptr::null_mut()
+        }
+        Err(error) => paimon_error::new(
+            PaimonErrorCode::Unexpected,
+            format!("export arrow schema: {error}"),
+        ),
+    }
+}
+
+/// Number of messages in a handle returned by `paimon_table_write_prepare_commit`.
+///
+/// A native committer needs this to bound its `serialize_range` chunks. It is a
+/// separate call rather than a field on `paimon_result_prepare_commit` so the
+/// prepare result keeps the layout other consumers already depend on.
+///
+/// Returns zero for a null handle.
+///
+/// # Safety
+/// `messages` must be a valid handle from `paimon_table_write_prepare_commit`,
+/// or null (returns zero).
+#[no_mangle]
+pub unsafe extern "C" fn paimon_commit_messages_count(
+    messages: *const paimon_commit_messages,
+) -> usize {
+    if messages.is_null() {
+        return 0;
+    }
+    let inner = (*messages).inner;
+    if inner.is_null() {
+        return 0;
+    }
+    let state = &*(inner as *const CommitMessagesState);
+    state.messages.len()
+}
+
+/// Serialize commit messages `[start, start + count)` as an unframed body of the
+/// version reported by `paimon_commit_message_serializer_version`.
+///
+/// An empty range is valid up to the message count. The body starts with the
+/// message count and carries no transport framing: the caller decides how to
+/// frame and chunk it (Doris wraps each chunk in its own DPCM header). Callers
+/// may inspect the returned length and retry a smaller range to stay under a
+/// transport payload limit.
+///
+/// Messages are never consumed or modified, including on failure. The returned
+/// bytes are independently owned, remain valid after the message handle is
+/// freed, and must be released with `paimon_bytes_free`.
+///
+/// # Safety
+/// `messages` must be a valid handle from `paimon_table_write_prepare_commit`,
+/// or null (returns an error). It must not be freed concurrently.
+#[no_mangle]
+pub unsafe extern "C" fn paimon_commit_messages_serialize_range(
+    messages: *const paimon_commit_messages,
+    start: usize,
+    count: usize,
+) -> paimon_result_bytes {
+    let serialized = (|| {
+        check_non_null(messages, "messages")?;
+        let inner = (*messages).inner;
+        check_non_null(inner, "messages.inner")?;
+        let state = &*(inner as *const CommitMessagesState);
+        let end = start
+            .checked_add(count)
+            .ok_or_else(|| invalid_input("commit message range overflows usize"))?;
+        let selected = state
+            .messages
+            .get(start..end)
+            .ok_or_else(|| invalid_input("commit message range is out of bounds"))?;
+        // Java `ObjectSerializer.serializeList` writes only the count followed
+        // by each message body -- the per-message length prefix belongs to the
+        // `BinaryRow` *inside* a message's file lists, not to the message
+        // itself. This body is exactly what that call produces.
+        let mut body = Vec::new();
+        body.extend_from_slice(&(selected.len() as i32).to_be_bytes());
+        for message in selected {
+            let row = message
+                .serialize_versioned(paimon::table::COMMIT_MESSAGE_SERIALIZER_VERSION)
+                .map_err(paimon_error::from_paimon)?;
+            body.extend_from_slice(&row);
+        }
+        Ok::<Vec<u8>, *mut paimon_error>(body)
+    })();
+    match serialized {
+        Ok(bytes) => paimon_result_bytes {
+            bytes: paimon_bytes::new(bytes),
+            error: ptr::null_mut(),
+        },
+        Err(error) => paimon_result_bytes {
+            bytes: paimon_bytes::empty(),
+            error,
+        },
+    }
+}
