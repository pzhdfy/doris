+    #[test]
+    fn java_v14_golden_round_trip() {
+        for golden in [EMPTY, INDEXED, RICH_INDEXED] {
+            let bytes = base64::engine::general_purpose::STANDARD
+                .decode(golden)
+                .unwrap();
+            let message =
+                CommitMessage::deserialize(COMMIT_MESSAGE_SERIALIZER_VERSION_V14, &bytes).unwrap();
+            assert_eq!(message.bucket, 3);
+            assert_eq!(message.check_from_snapshot, Some(7));
+            assert_eq!(
+                message.serialize_versioned(COMMIT_MESSAGE_SERIALIZER_VERSION_V14).unwrap(),
+                bytes
