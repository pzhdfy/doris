+// ===== Native committer helpers (export schema / serialize range) =====
+
+#[test]
+fn serializer_version_reports_the_linked_java_release() {
+    // Paimon 1.4.x links CommitMessageSerializer v11. This is what a native
+    // committer frames its payloads with; moving Paimon forward changes only
+    // the constant, not the ABI.
+    assert_eq!(paimon_commit_message_serializer_version(), 11);
+}
+
+#[test]
+fn serialize_range_rejects_out_of_bounds_and_null() {
+    unsafe {
+        let bytes = paimon_commit_messages_serialize_range(
+            std::ptr::null(),
+            0,
+            0,
+        );
+        assert!(!bytes.error.is_null());
+        assert!(bytes.bytes.data.is_null());
+        paimon_error_free(bytes.error);
+    }
+}
+
+/// End-to-end: open a real table, write one arrow batch through the FFI,
+/// prepare the commit and serialize the range. The bytes must be what Paimon
+/// 1.4.2's `CommitMessageSerializer` reads back.
+#[test]
+fn write_prepare_and_serialize_range_end_to_end() {
+    unsafe {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().to_str().unwrap().to_string();
+
+        // Build a minimal paimon table on disk via the writer itself: schema
+        // json comes from `paimon_table_from_schema_json`'s counterpart, so we
+        // create it once with the schema file the reader expects.
+        let schema_json = r#"{
+            "version": 1,
+            "id": 0,
+            "fields": [
+                {"id": 0, "name": "id", "type": "INT NOT NULL"},
+                {"id": 1, "name": "v", "type": "STRING"}
+            ],
+            "highestFieldId": 1,
+            "partitionKeys": [],
+            "primaryKeys": [],
+            "options": {"bucket": "-1"},
+            "timeMillis": 1700000000000,
+            "comment": null
+        }"#;
+        // paimon expects <warehouse>/<db>.db/<table>/schema/schema-0
+        let table_dir = format!("{path}/db.db/t");
+        std::fs::create_dir_all(format!("{table_dir}/schema")).unwrap();
+        std::fs::write(format!("{table_dir}/schema/schema-0"), schema_json).unwrap();
+
+        let mut c_path = std::ffi::CString::new(table_dir.clone()).unwrap();
+        let tbl = paimon_table_from_schema_json(
+            c_path.as_ptr(),
+            std::ffi::CString::new(schema_json).unwrap().as_ptr(),
+            std::ffi::CString::new("db").unwrap().as_ptr(),
+            std::ffi::CString::new("t").unwrap().as_ptr(),
+            std::ptr::null(),
+            std::ptr::null(),
+            0,
+        );
+        if !tbl.error.is_null() {
+            let e = &*tbl.error;
+            panic!("open table: code={}", e.code);
+        }
+
+        // export arrow schema
+        let mut ffi_schema = std::mem::MaybeUninit::<FFI_ArrowSchema>::uninit();
+        let err = paimon_table_export_arrow_schema(
+            tbl.table,
+            ffi_schema.as_mut_ptr() as *mut c_void,
+        );
+        assert!(err.is_null(), "export_arrow_schema failed");
+        let ffi_schema = ffi_schema.assume_init();
+        let schema = Arc::new(ArrowSchema::try_from(&ffi_schema).unwrap());
+        assert_eq!(schema.fields().len(), 2);
+        assert_eq!(schema.field(0).name(), "id");
+        assert_eq!(schema.field(1).name(), "v");
+
+        println!("E2E_SCHEMA_OK fields={}", schema.fields().len());
+
+        // ---- write one batch through the FFI, prepare, serialize ----
+        let mut wb = paimon_table_new_write_builder_with_commit_user(
+            tbl.table,
+            std::ffi::CString::new("e2e-user").unwrap().as_ptr(),
+        );
+        assert!(wb.error.is_null(), "new_write_builder failed");
+        let tw = paimon_write_builder_new_write(wb.write_builder);
+        if !tw.error.is_null() {
+            let e = &*tw.error;
+            let msg = std::slice::from_raw_parts(e.message.data, e.message.len);
+            panic!("new_write failed: {}", String::from_utf8_lossy(msg));
+        }
+
+        let ids = Int32Array::from(vec![1, 2, 3]);
+        let vs = StringArray::from(vec![Some("a"), Some("b"), None]);
+        let batch = RecordBatch::try_new(
+            schema.clone(),
+            vec![Arc::new(ids) as _, Arc::new(vs) as _],
+        )
+        .unwrap();
+        let struct_array = StructArray::from(batch);
+        let ffi_array = FFI_ArrowArray::new(&struct_array.to_data());
+        let ffi_schema2 = FFI_ArrowSchema::try_from(schema.as_ref()).unwrap();
+        let werr = paimon_table_write_write_arrow_batch(
+            tw.write,
+            Box::into_raw(Box::new(ffi_array)) as *mut c_void,
+            Box::into_raw(Box::new(ffi_schema2)) as *mut c_void,
+        );
+        assert!(werr.is_null(), "write_arrow_batch failed");
+
+        let pc = paimon_table_write_prepare_commit(tw.write);
+        assert!(pc.error.is_null(), "prepare_commit failed");
+        assert!(!pc.messages.is_null());
+
+        let bytes = paimon_commit_messages_serialize_range(pc.messages, 0, 1);
+        assert!(bytes.error.is_null(), "serialize_range failed");
+        assert!(!bytes.bytes.data.is_null());
+        let body = std::slice::from_raw_parts(bytes.bytes.data, bytes.bytes.len);
+        println!("E2E_COMMIT_LEN={}", body.len());
+        println!("E2E_COMMIT_HEX={}", body.iter().map(|b| format!("{b:02x}")).collect::<String>());
+
+        paimon_bytes_free(bytes.bytes);
+        paimon_commit_messages_free(pc.messages);
+        paimon_table_write_free(tw.write);
+        println!("E2E_DONE");
+    }
+}
